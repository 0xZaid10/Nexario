# ─── Nexario Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=./nexario.db

# ─── Backend wallet ───────────────────────────────────────────────────────────
# Signs agent sub-delegations. Never holds user funds.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_KEY=0x

# ─── RPC endpoints ────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# MAINNET_RPC_URL=https://eth.llamarpc.com

# ─── Venice AI ────────────────────────────────────────────────────────────────
# Get from: https://venice.ai/settings/api
VENICE_API_KEY=

# Optional: separate wallet for Venice x402 payments
# If not set, falls back to API key auth
# VENICE_WALLET_PRIVATE_KEY=0x

# ─── 1Shot Relayer ────────────────────────────────────────────────────────────
# Default points to mainnet relayer — no signup required
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com/relayers

# Ed25519 public key for webhook signature verification
# Get from 1Shot dashboard after setting up webhook destination
# ONESHOT_WEBHOOK_PUBLIC_KEY=

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get from @BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=https://your-domain.com

# ─── API Security ─────────────────────────────────────────────────────────────
# Change this in production — used for X-API-Key header
NEXARIO_API_KEY=nexario-dev-key-change-in-prod

# ─── Smart Contracts ──────────────────────────────────────────────────────────
# MetaMask DelegationManager on Sepolia
# Check: https://github.com/MetaMask/delegation-framework
DELEGATION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Set after running: npm run deploy:sepolia
# AGENT_REGISTRY_ADDRESS=0x
# REPUTATION_REGISTRY_ADDRESS=0x

# ─── Misc ─────────────────────────────────────────────────────────────────────
# ETHERSCAN_API_KEY=
LOG_LEVEL=info
